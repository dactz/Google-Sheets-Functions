// Function to fetch email from a GitHub profile URL using the GitHub API
function getGitHubEmail(gitHubUrl) {
  const baseApiUrl = "https://api.github.com";
  const token = "YOUR_GITHUB_PERSONAL_ACCESS_TOKEN"; // Optional: Add a personal access token here if rate-limiting becomes an issue

  try {
    // Extract the GitHub username from the provided URL
    const match = gitHubUrl.match(/^https:\/\/github\.com\/([^\/]+)/);
    if (!match) {
      return "Invalid GitHub URL";
    }
    const username = match[1];
    
    // Step 1: Fetch public repositories for the user
    const repoUrl = `${baseApiUrl}/users/${username}/repos`;
    const repoResponse = UrlFetchApp.fetch(repoUrl, {
      headers: {
        Authorization: `token ${token}`,
        Accept: "application/vnd.github.v3+json"
      },
      muteHttpExceptions: true
    });

    if (repoResponse.getResponseCode() !== 200) {
      return `Error fetching repositories: ${repoResponse.getContentText()}`;
    }

    const repos = JSON.parse(repoResponse.getContentText());

    // Step 2: Loop through each repository to find the latest commit
    for (const repo of repos) {
      const commitsUrl = `${repo.commits_url.replace('{/sha}', '')}?per_page=1`;
      const commitResponse = UrlFetchApp.fetch(commitsUrl, {
        headers: {
          Authorization: `token ${token}`,
          Accept: "application/vnd.github.v3+json"
        },
        muteHttpExceptions: true
      });

      if (commitResponse.getResponseCode() !== 200) {
        continue; // Skip this repository if there's an issue fetching the commits
      }

      const commits = JSON.parse(commitResponse.getContentText());
      if (commits.length > 0) {
        const commit = commits[0];
        const email = commit.commit.author.email;

        // Exclude GitHub's noreply emails
        if (!email.includes("noreply.github.com")) {
          return email;
        }
      }
    }

    return "No email found";

  } catch (error) {
    return `Error: ${error.message}`;
  }
}
// Function to get remaining API requests for the GitHub API
function getGitHubApiLimit() {
  const token = "YOUR_GITHUB_PERSONAL_ACCESS_TOKEN"; // Replace with your GitHub personal access token (optional)
  const apiUrl = "https://api.github.com/rate_limit";
  
  const options = {
    method: "GET",
    headers: {
      Authorization: `token ${token}`, // Authenticated request to get higher rate limits
      Accept: "application/vnd.github.v3+json"
    },
    muteHttpExceptions: true
  };

  try {
    // Fetch rate limit data from GitHub API
    const response = UrlFetchApp.fetch(apiUrl, options);
    
    if (response.getResponseCode() !== 200) {
      return `Error: Unable to fetch rate limit (${response.getResponseCode()})`;
    }
    
    const data = JSON.parse(response.getContentText());
    
    // Extract core API rate limit information
    const core = data.resources.core;
    const remaining = core.remaining;    // How many requests are left
    const resetTime = new Date(core.reset * 1000);  // Convert Unix timestamp to JavaScript Date object
    
    // Calculate time remaining before reset
    const now = new Date();
    const minutesLeft = Math.floor((resetTime - now) / 60000);  // Convert milliseconds to minutes
    
    // Return the number of remaining requests and time until reset
    return `Requests remaining: ${remaining}, Reset in: ${minutesLeft} minutes`;
    
  } catch (error) {
    return `Error: ${error.message}`;
  }
}
function getGitHubAccountByEmail(email) {
  // Validate email input
  if (!email || typeof email !== 'string') {
    return 'Invalid email';
  }

  // GitHub Search API endpoint
  const apiUrl = `https://api.github.com/search/users?q=${encodeURIComponent(email)}+in:email`;

  // GitHub Personal Access Token (optional to avoid rate limits)
  const token = 'your_github_token'; // replace 'your_github_token' with your GitHub token if desired
  const headers = token ? { 'Authorization': `token ${token}` } : {};

  try {
    const response = UrlFetchApp.fetch(apiUrl, { headers });
    const data = JSON.parse(response.getContentText());

    // Check if users are found
    if (data.total_count > 0 && data.items.length > 0) {
      // Return the first matching GitHub username
      return data.items[0].html_url;
    } else {
      return 'No GitHub account found';
    }
  } catch (error) {
    return 'Error fetching data';
  }
}

function getGitHubEmail2(gitHubUrl) {

  // =========================================================
  // SETTINGS
  // =========================================================

  const TOKEN = "YOUR_GITHUB_PERSONAL_ACCESS_TOKEN";

  // Maximum number of repositories to inspect
  const MAX_REPOS = 10;

  // Only inspect the 10 most recent commits per repository
  const COMMITS_PER_REPO = 10;


  // =========================================================
  // VALIDATE URL
  // =========================================================

  if (!gitHubUrl) {
    return "No GitHub URL";
  }

  const match = String(gitHubUrl).match(
    /^https?:\/\/(?:www\.)?github\.com\/([^\/?#]+)/i
  );

  if (!match) {
    return "Invalid GitHub URL";
  }

  const username = match[1];


  // =========================================================
  // API OPTIONS
  // =========================================================

  const headers = {
    "Accept": "application/vnd.github+json"
  };

  if (
    TOKEN &&
    TOKEN !== "YOUR_GITHUB_PERSONAL_ACCESS_TOKEN"
  ) {
    headers["Authorization"] = "Bearer " + TOKEN;
  }

  const options = {
    method: "get",
    headers: headers,
    muteHttpExceptions: true
  };


  try {

    // =======================================================
    // GET 10 MOST RECENTLY ACTIVE REPOSITORIES
    // =======================================================

    const reposUrl =
      "https://api.github.com/users/" +
      encodeURIComponent(username) +
      "/repos?type=all&sort=pushed&direction=desc&per_page=" +
      MAX_REPOS;

    const reposResponse = UrlFetchApp.fetch(
      reposUrl,
      options
    );

    const repoStatus = reposResponse.getResponseCode();

    if (repoStatus === 403 || repoStatus === 429) {
      return "GitHub API rate limit reached";
    }

    if (repoStatus !== 200) {
      return "GitHub error: " + repoStatus;
    }

    const repos = JSON.parse(
      reposResponse.getContentText()
    );

    if (!repos || repos.length === 0) {
      return "No public repositories found";
    }


    // =======================================================
    // COUNT EMAILS
    // =======================================================

    const emailCounts = {};


    // =======================================================
    // CHECK EACH REPOSITORY
    // =======================================================

    for (const repo of repos) {

      const owner = repo.owner.login;
      const repoName = repo.name;

      const commitsUrl =
        "https://api.github.com/repos/" +
        encodeURIComponent(owner) +
        "/" +
        encodeURIComponent(repoName) +
        "/commits?per_page=" +
        COMMITS_PER_REPO;

      const commitResponse = UrlFetchApp.fetch(
        commitsUrl,
        options
      );

      // Skip repositories where commits can't be accessed
      if (commitResponse.getResponseCode() !== 200) {
        continue;
      }

      const commits = JSON.parse(
        commitResponse.getContentText()
      );

      if (!commits || commits.length === 0) {
        continue;
      }


      // =====================================================
      // COUNT COMMIT EMAILS
      // =====================================================

      for (const commit of commits) {

        if (
          !commit.commit ||
          !commit.commit.author ||
          !commit.commit.author.email
        ) {
          continue;
        }

        const email =
          commit.commit.author.email
            .toLowerCase()
            .trim();

        // Ignore GitHub noreply addresses
        if (
          !email ||
          email.includes("noreply.github.com")
        ) {
          continue;
        }

        emailCounts[email] =
          (emailCounts[email] || 0) + 1;
      }
    }


    // =======================================================
    // FIND MOST COMMON EMAIL
    // =======================================================

    const rankedEmails = Object.entries(emailCounts)
      .sort((a, b) => b[1] - a[1]);

    if (rankedEmails.length === 0) {
      return "No public email found";
    }

    return rankedEmails[0][0];


  } catch (error) {

    return "Error: " + error.message;

  }
}
